{
  "name": "ipasscare-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:refactor": "node scripts/verify-refactor.mjs regression",
    "verify:refactor": "node scripts/verify-refactor.mjs all",
    "dev": "vite --mode development",
    "dev:production": "vite --mode production",
    "dev:local": "vite --mode development",
    "dev:preview": "vite --mode preview",
    "build:preview": "vite build --mode preview",
    "build:local": "vite build --mode development --outDir dist-local",
    "test:environment": "node --test tests/environment.test.mjs",
    "test:payment-cancel": "node --test tests/paymentCancellation.test.mjs",
    "test:payment-history": "node --test tests/paymentHistory.test.mjs",
    "test:schedule": "node --test tests/weeklySchedule.test.mjs tests/weeklyScheduleView.test.mjs",
    "test:admin-content": "node --test tests/adminContentReads.test.mjs",
    "test:admin-settings": "node --test tests/adminSettingsWrite.test.mjs",
    "test:admin-videos": "node --test tests/adminVideoWrites.test.mjs",
    "test:admin-partners": "node --test tests/adminPartnerWrites.test.mjs",
    "test:type-cleanup": "node --test tests/typeCleanup.test.mjs",
    "test:hook-dependencies": "node --test tests/hookDependencies.test.mjs",
    "test:notices": "node --test tests/noticeReads.test.mjs",
    "test:notice-writes": "node --test tests/noticeWrites.test.mjs",
    "test:dashboard": "node --test tests/dashboardReads.test.mjs",
    "test:class-management": "node --test tests/classManagementReads.test.mjs",
    "test:referrals": "node --test tests/referralReads.test.mjs",
    "test:shuttle-map": "node --test tests/shuttleMapLifecycle.test.mjs",
    "test:class-writes": "node --test tests/classWrites.test.mjs",
    "test:attendance": "node --test tests/attendanceLedger.test.mjs tests/attendanceLedgerModel.test.mjs tests/attendanceViews.test.mjs tests/attendanceLedgerActions.test.mjs tests/timelineAction.test.mjs tests/batchTimelineAction.test.mjs",
    "test:excel": "node --test tests/excelExports.test.mjs tests/studentImport.test.mjs tests/studentImportSave.test.mjs",
    "test:billing": "node --test tests/billingPlan.test.mjs tests/offlineLedger.test.mjs tests/offlinePayment.test.mjs tests/billDelivery.test.mjs tests/billActions.test.mjs tests/billCreation.test.mjs tests/billingAutomation.test.mjs tests/billingTargets.test.mjs tests/billingReads.test.mjs tests/billingAmount.test.ts tests/billingReminder.test.ts",
    "test:journals": "node --test tests/counselWrites.test.mjs tests/studyWrites.test.mjs tests/counselData.test.mjs tests/studyData.test.mjs",
    "test:students": "node --test tests/studentData.test.mjs tests/withdrawalData.test.mjs tests/studentDetailData.test.mjs tests/studentSave.test.mjs tests/studentBilling.test.mjs tests/studentLifecycle.test.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
