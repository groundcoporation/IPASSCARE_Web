{
  "name": "ipasscare-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:refactor": "node scripts/verify-refactor.mjs regression",
    "verify:refactor": "node scripts/verify-refactor.mjs all",
    "dev": "vite --mode development",
    "dev:production": "vite --mode production",
    "dev:local": "vite --mode development",
    "dev:preview": "vite --mode preview",
    "build:preview": "vite build --mode preview",
    "build:local": "vite build --mode development --outDir dist-local",
    "test:environment": "node --test tests/environment/environment.test.mjs",
    "test:payment-cancel": "node --test tests/admin/billing/paymentCancellation.test.mjs",
    "test:payment-history": "node --test tests/admin/billing/paymentHistory.test.mjs",
    "test:schedule": "node --test tests/admin/classes/weeklySchedule.test.mjs tests/admin/classes/weeklyScheduleView.test.mjs",
    "test:admin-content": "node --test tests/admin/site/adminContentReads.test.mjs",
    "test:admin-settings": "node --test tests/admin/site/adminSettingsWrite.test.mjs",
    "test:admin-videos": "node --test tests/admin/site/adminVideoWrites.test.mjs",
    "test:admin-partners": "node --test tests/admin/site/adminPartnerWrites.test.mjs",
