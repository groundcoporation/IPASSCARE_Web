    "test:attendance": "node --test tests/admin/attendance/attendanceLedger.test.mjs tests/admin/attendance/attendanceLedgerModel.test.mjs tests/admin/attendance/attendanceViews.test.mjs tests/admin/attendance/attendanceLedgerActions.test.mjs tests/admin/attendance/timelineAction.test.mjs tests/admin/attendance/batchTimelineAction.test.mjs",
    "test:excel": "node --test tests/shared/excelExports.test.mjs tests/admin/students/studentImport.test.mjs tests/admin/students/studentImportSave.test.mjs",
    "test:billing": "node --test tests/admin/billing/billingPlan.test.mjs tests/admin/billing/offlineLedger.test.mjs tests/admin/billing/offlinePayment.test.mjs tests/admin/billing/billDelivery.test.mjs tests/admin/billing/billActions.test.mjs tests/admin/billing/billCreation.test.mjs tests/admin/billing/billingAutomation.test.mjs tests/admin/billing/billingTargets.test.mjs tests/admin/billing/billingReads.test.mjs tests/admin/billing/billingAmount.test.ts tests/admin/billing/billingReminder.test.ts",
    "test:journals": "node --test tests/admin/journals/counselWrites.test.mjs tests/admin/journals/studyWrites.test.mjs tests/admin/journals/counselData.test.mjs tests/admin/journals/studyData.test.mjs",
    "test:students": "node --test tests/admin/students/studentData.test.mjs tests/admin/students/withdrawalData.test.mjs tests/admin/students/studentDetailData.test.mjs tests/admin/students/studentSave.test.mjs tests/admin/students/studentBilling.test.mjs tests/admin/students/studentLifecycle.test.mjs",
