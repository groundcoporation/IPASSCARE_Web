# Copy to .env.development.local in this directory. Never commit actual values.
# Public client configuration only. No service_role / sb_secret_ keys.
VITE_APP_ENV=development
VITE_SUPABASE_PROJECT_REF=local
VITE_SUPABASE_URL=http://127.0.0.1:45431
VITE_SUPABASE_ANON_KEY=
# Leave SMS relay unset in non-production; do not point it at production.
VITE_SMS_RELAY_URL=
